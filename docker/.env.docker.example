# Copie estas variáveis para o seu .env do Laravel (mantendo os valores de gateway
# de pagamento e demais chaves específicas da aplicação já existentes no arquivo).

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=foodflix
DB_USERNAME=foodflix
DB_PASSWORD=foodflix

# Usado apenas pelo container do MySQL (docker-compose.yml) — não é lido pelo Laravel
DB_ROOT_PASSWORD=root
